# Copy this file to `.env` and fill in values.
# `.env` is gitignored — NEVER commit real tokens.
#
#   cp .env.example .env
#
# (./setup.sh creates and fills this for you if you choose diarization.)

# ── Speaker diarization (optional) ────────────────────────────────────
# Free token from https://huggingface.co/settings/tokens
# Also accept the model licenses (see README) before first use.
HF_TOKEN=

# ── Server overrides (optional) ───────────────────────────────────────
# MS_HOST=127.0.0.1      # use 0.0.0.0 to share on your local network
# MS_PORT=5001
# MS_DATA_DIR=./data

# Engine: auto (mlx on Apple Silicon, faster-whisper elsewhere), mlx or faster-whisper.
# MS_ENGINE=auto
# faster-whisper only:
# MS_FW_COMPUTE_TYPE=int8
# MS_FW_THREADS=
# 0 hides the "Stop app" button and turns off its route. The Docker image sets 0.
# ALLOW_SHUTDOWN=1
